# Copy to .env for local Vite development. Firebase web configuration is public;
# access to records and photos is enforced by Authentication and Security Rules.
VITE_FIREBASE_API_KEY=replace-with-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-project-id.firebasestorage.app
VITE_FIREBASE_APP_ID=replace-with-web-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id

# Optional: Vite's local /api proxy target.
VITE_DEV_BACKEND_URL=https://agri-vision-eosin.vercel.app

# Free cloud workspace: Firebase Auth/Firestore + Vercel Private Blob/API.
# npm run dev needs no local model or owner Admin credential in this mode.
# Sign-in is the default. Continue as guest opens saved browser history.
# VITE_WORKSPACE_MODE applies only to signed-in accounts.
VITE_WORKSPACE_MODE=cloud
VITE_DEV_WORKSPACE_URL=https://agri-vision-eosin.vercel.app

# Production Gemini configuration belongs in Vercel server settings, never here.
# For an explicitly local-mode pilot only, save one line
# GEMINI_API_KEY=your-key in ~/.config/agri-vision/ai.env, then chmod 600 that
# private file. npm run pilot loads it only for the local workspace service.
# A server environment GEMINI_API_KEY also works. Never use a VITE_ prefix.
# Without a key, scanning still works and standard care guidance is available.
# Optional private AI config settings can lower the pilot daily caps:
# AGRI_VISION_AI_OWNER_DAILY_LIMIT=10
# AGRI_VISION_AI_GLOBAL_DAILY_LIMIT=50
# AGRI_VISION_AI_COOLDOWN_SECONDS=30

# Optional: use the Firebase Emulator Suite during local development.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
