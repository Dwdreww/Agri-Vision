{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/predict.mjs": {
      "maxDuration": 60
    },
    "api/health.mjs": {
      "maxDuration": 10
    },
    "api/workspace.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/workspace/:path*", "destination": "/api/workspace?workspacePath=:path*" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
